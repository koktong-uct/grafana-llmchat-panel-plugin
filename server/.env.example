# Choose one PostgreSQL host and the database containing the three manufacturing tables.
PGHOST=postgres.example.com
# PGHOST=postgres-replica.example.com
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
# Set to your database CA file if the server requires TLS.
# PGSSLROOTCERT=/path/to/postgres-ca.pem
# PGSSLMODE=verify-full

# Optional read-only connections for inspection KPIs. Use the real host and port for each source.
# UCAP_AOI01_DATABASE_URL=postgresql://user:password@host:5432/uct-aoi01
# UCAP_AOI02_DATABASE_URL=postgresql://user:password@host:5432/uct-aoi02
# UCME_WLD01_DATABASE_URL=postgresql://user:password@host:5432/postgres

# Grafana LLM app with its Base model mapping already configured.
GRAFANA_URL=http://localhost:3000
# For HTTPS with a private CA, set the path to the trusted CA's PEM file.
# GRAFANA_TLS_CA_FILE=/path/to/grafana-ca.pem
# When local port forwarding uses a different hostname, set the DNS name in the certificate.
# GRAFANA_TLS_SERVER_NAME=grafana.example.com
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_LLM_MODEL=base

CHAT_HOST=127.0.0.1
CHAT_PORT=8787
CHAT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
